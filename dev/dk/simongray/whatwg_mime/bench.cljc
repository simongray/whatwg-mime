(ns dk.simongray.whatwg-mime.bench
  "Benchmarks of reading a Content-Type, and of sniffing and decoding what
  a crawler fetches, timed by criterium on the JVM and by the clock in
  Node. On the JVM, clj-async-profiler draws flame graphs.

      clojure -M:bench -m dk.simongray.whatwg-mime.bench
      clojure -M:cljs release bench && node target/bench.js

  In a REPL with the :bench alias, (run) gives the mean of each case in
  microseconds, and (profile :binary 10) the file of a flame graph."
  (:require #?@(:clj [[clj-async-profiler.core :as prof]
                      [criterium.core :as criterium]])
            [clojure.string :as str]
            [dk.simongray.whatwg-mime :as mime]
            [dk.simongray.whatwg-mime.patterns :as patterns]))

(defn- latin-1
  "The bytes of the text `s`, a byte for each of its characters."
  [s]
  #?(:clj  (.getBytes ^String s "ISO-8859-1")
     :cljs (js/Uint8Array.from (map #(.charCodeAt % 0) s))))

(def text
  "1445 bytes of plain text."
  (latin-1 (subs (str/join (repeat 40 "The quick brown fox jumps over the lazy dog. ")) 0 1445)))

(def binary
  "1445 bytes of compressed data, with a binary byte at the end."
  (latin-1 (str (subs (str/join (repeat 250 "§ñÞ\u0099Ã ")) 0 1444) "\u0000")))

(def page
  "The start of an HTML page."
  (latin-1 "\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<head><title>A page</title>"))

(def png
  "The start of a PNG image."
  (latin-1 "\u0089PNG\r\n\u001A\n\u0000\u0000\u0000\rIHDR"))

(def mp3
  "The start of an MP3 file without ID3: two frames of 128 kbit/s."
  (latin-1 (str "ÿû\u0090\u0000" (str/join (repeat 413 "\u0000")) "ÿû\u0090\u0000")))

(def feed
  "The start of an RSS feed with a stylesheet."
  (latin-1 (str "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
                "<?xml-stylesheet type=\"text/xsl\" href=\"/feed.xsl\"?>\n"
                "<!-- generated by a static site generator -->\n"
                "<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\">")))

(def cases
  "Each case by name, as a function to time."
  (let [m (mime/parse "text/html;charset=utf-8")]
    {:parse     #(mime/parse "text/html; charset=utf-8")
     :serialize #(mime/serialize m)
     :extract   #(mime/extract ["text/plain;charset=gbk" "text/html; charset=utf-8"])
     :encoding  #(mime/encoding "text/html; charset=ISO-8859-1")
     :page      #(mime/sniff page nil)
     :png       #(mime/sniff png "image/png")
     :mp3       #(patterns/audio-or-video-type mp3)
     :text      #(mime/sniff text "text/plain")
     :binary    #(mime/sniff binary nil)
     :feed      #(patterns/feed-type feed)
     :latin-1   #(mime/decode text "latin1")
     :utf-8     #(mime/decode text "utf-8")}))

#?(:cljs
   (defn- mean
     "The mean time of a call of `f` in seconds, over a second of calls
     after a second of warming up."
     [f]
     (let [now   #(js/performance.now)
           calls (fn [ms]
                   (let [end (+ (now) ms)]
                     (loop [n 0]
                       (if (< (now) end)
                         (do (dotimes [_ 100] (f)) (recur (+ n 100)))
                         n))))]
       (calls 1000)
       (let [start (now)
             n     (calls 1000)]
         (/ (- (now) start) n 1000)))))

(defn run
  "The mean time of each case, or of those named `ks`, in microseconds."
  ([]
   (run (keys cases)))
  ([ks]
   (into (sorted-map)
         (for [k    ks
               :let [mean #?(:clj  (first (:mean (criterium/quick-benchmark* (cases k) {})))
                             :cljs (mean (cases k)))]]
           [k (/ (Math/round (* mean 1e9)) 1000.0)]))))

#?(:clj
   (defn profile
     "The file of a flame graph of the case `k`, run for `seconds` by
     clj-async-profiler."
     [k seconds]
     (let [f   (cases k)
           end (+ (System/currentTimeMillis) (* 1000 seconds))]
       (prof/profile (while (< (System/currentTimeMillis) end) (f))))))

(defn -main
  "Print the mean time of each case."
  [& _]
  (doseq [[k us] (run)]
    (println (str (name k) (str/join (repeat (- 10 (count (name k))) " ")) us " µs")))
  #?(:clj (shutdown-agents)))

(comment
  (run)
  (run [:parse :binary])
  (profile :binary 10)
  #_.)
